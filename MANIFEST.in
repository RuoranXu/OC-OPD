include pyproject.toml setup.py README.md NOTICE requirements*.txt
recursive-include oc_opd/trainer/config *.yaml
recursive-include verl *.yaml
include verl/version/version verl/LICENSE verl/NOTICE
recursive-include third_party/verl *
recursive-include recipe *.sh *.yaml
recursive-include examples *.sh *.py *.txt *.yaml *.json
recursive-include scripts *.sh *.py
recursive-include data .gitkeep
include docker/Dockerfile .dockerignore
global-exclude __pycache__ *.py[cod]
